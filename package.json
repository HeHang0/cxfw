{
  "name": "cfmoto-ride",
  "private": true,
  "version": "0.1.0",
  "description": "春风摩托个人骑行数据小程序（uni-app + Vue 3 + TypeScript）",
  "scripts": {
    "dev:h5": "uni",
    "dev:mp-weixin": "uni -p mp-weixin",
